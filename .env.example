# Optional OpenAI-compatible API. Without it, local evidence search still runs.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=
AI_VISION_MODEL=
MAX_UPLOAD_MB=25
# Optional host port for Docker Compose (container always listens on 8000).
NIS2_HOST_PORT=8000
# demo (10 article 21 families) or recyf (152 bundled v2.5 measures)
CATALOG_MODE=demo
# Optional: override the OS-specific persistent data directory.
# NIS2_DATA_DIR=

